<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <SolidColorBrush x:Key="AppTextBrush" Color="#F2F4F8" />
    <SolidColorBrush x:Key="AppMutedTextBrush" Color="#BFC0C0" />
  </Styles.Resources>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource AppTextBrush}" />
    <Setter Property="SelectionBrush" Value="#334B66" />
  </Style>
  <Style Selector="Button">
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>
  <Style Selector="ToggleButton">
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>
</Styles>
