<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Noteflow.ViewModels"
             xmlns:models="clr-namespace:Noteflow.Models"
             xmlns:views="clr-namespace:Noteflow.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="Noteflow.Views.CardListView"
             x:DataType="vm:CardListViewModel"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             mc:Ignorable="d">

    <Grid ColumnDefinitions="220,*" Margin="10">
        <views:CardFilterView Grid.Column="0" DataContext="{Binding Browser.FilterViewModel}" />

        <ListBox Grid.Column="1"
                 ItemsSource="{Binding Browser.Cards}"
                 HorizontalAlignment="Stretch"
                 Margin="0,4,12,0">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="6,3" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
                <Style Selector="ListBoxItem:nth-child(odd)">
                    <Setter Property="Background" Value="#2B2F33" />
                </Style>
                <Style Selector="ListBoxItem:nth-child(even)">
                    <Setter Property="Background" Value="#30353A" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:IndexCard">
                    <Button Padding="4,2"
                            Margin="0"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            x:CompileBindings="False"
                            Command="{Binding DataContext.Browser.OpenCardCommand, RelativeSource={RelativeSource AncestorType=views:CardListView}}"
                            CommandParameter="{Binding}">
                        <Grid ColumnDefinitions="*,Auto"
                              RowDefinitions="Auto">
                            <TextBlock Text="{Binding Front}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1"
                                       Margin="12,0,0,0"
                                       Text="{Binding Category}"
                                       FontSize="12"
                                       Foreground="#bfc0c0"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Button>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
