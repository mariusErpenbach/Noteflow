<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Noteflow.ViewModels"
             xmlns:md="clr-namespace:Markdown.Avalonia;assembly=Markdown.Avalonia"
             x:Class="Noteflow.Views.NewCardFormularView"
             x:DataType="vm:NewCardFormularViewModel">
    
    <StackPanel>
        <TextBox Watermark="Front" Text="{Binding Front}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Height="180">
            <TextBox Watermark="Back"
                     Text="{Binding Back}"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top" />
        </ScrollViewer>
        <TextBox Watermark="Category" Text="{Binding Category}" />
        <Button Content="Speichern" Command="{Binding SaveCommand}" />
        <Expander Header="Vorschau"
                  IsExpanded="False"
                  Margin="0,6,0,0">
            <Border Background="#081F33"
                    CornerRadius="8"
                    Padding="8"
                    Height="160">
                <md:MarkdownScrollViewer Markdown="{Binding Back}" />
            </Border>
        </Expander>
    </StackPanel>
</UserControl>
