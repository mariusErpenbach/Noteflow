<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Noteflow.Views"
             x:Class="Noteflow.Views.CardDetailModalView">
    <Grid IsVisible="{Binding IsCardDetailOpen}"
          Background="#80000000"
          Panel.ZIndex="10"
          x:CompileBindings="False">
        <Border Background="#2b2d42"
                CornerRadius="12"
                Padding="12"
                Width="720"
                Height="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <ContentControl Content="{Binding CardDetail}" />
        </Border>
    </Grid>
</UserControl>
