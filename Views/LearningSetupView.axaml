<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Noteflow.ViewModels"
             x:Class="Noteflow.Views.LearningSetupView"
             x:DataType="vm:LearningSetupViewModel">
    <Grid Margin="10">
        <Border Background="#081F33" CornerRadius="10" Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" Width="520">
            <StackPanel Spacing="12">
                <TextBlock Text="Lernmodus" FontWeight="Bold" FontSize="20" />
                <TextBlock Text="Wähle zuerst ein Set aus, bevor du startest." FontSize="12" TextWrapping="Wrap" />
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="Auto,Auto">
                        <TextBlock Text="Set auswählen" FontSize="12" />
                        <TextBlock Grid.Column="1"
                                   Margin="8,0,0,0"
                                   Text="{Binding SelectedSetCardCount, StringFormat=({0} Karten)}"
                                   FontSize="12"
                                   Opacity="0.8"
                                   IsVisible="{Binding HasSelectedSet}" />
                    </Grid>
                    <ComboBox ItemsSource="{Binding Sets}"
                              SelectedItem="{Binding SelectedSet}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <Button Content="Lernen starten" Command="{Binding StartLearningCommand}" IsEnabled="{Binding HasSelectedSet}" />
                <Border Background="#0F2A45" CornerRadius="8" Padding="10">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Demnächst" FontWeight="Bold" FontSize="12" />
                        <TextBlock Text="Weitere Lernmodi und Einstellungen folgen hier." FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
