<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Noteflow.ViewModels"
             x:Class="Noteflow.Views.NewCardSetView"
             x:DataType="vm:NewCardSetViewModel">
    <Border Background="#081F33" CornerRadius="10" Padding="16" Margin="20">
        <StackPanel Spacing="12" Width="360">
            <TextBlock Text="Neues Set" FontWeight="Bold" FontSize="18" />
            <TextBox Watermark="Name des Sets" Text="{Binding Name}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Speichern" Command="{Binding SaveCommand}" />
                <Button Content="Abbrechen" Command="{Binding CancelCommand}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
