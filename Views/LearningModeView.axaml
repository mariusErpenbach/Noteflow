<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Noteflow.ViewModels"
             x:Class="Noteflow.Views.LearningModeView"
             x:DataType="vm:LearningModeViewModel">
    <Grid ColumnDefinitions="260,*" Margin="10">
        <Border Background="#081F33" CornerRadius="10" Padding="12">
            <StackPanel Spacing="10">
                <TextBlock Text="Lernmodus" FontWeight="Bold" FontSize="16" />
                <TextBlock Text="Set wählen" FontSize="12" />
                <ComboBox ItemsSource="{Binding Sets}"
                          SelectedItem="{Binding SelectedSet}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding ProgressText}" FontSize="12" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Start" Command="{Binding StartCommand}" IsEnabled="{Binding HasSelectedSet}" />
                    <Button Content="Antwort abschicken"
                            Command="{Binding SubmitAndNextCommand}"
                            IsEnabled="{Binding HasCurrentCard}" />
                </StackPanel>
                <TextBlock Text="Hinweis:" FontWeight="Bold" FontSize="12" Margin="0,12,0,0" />
                <TextBlock Text="LLM muss lokal vorhanden sein." TextWrapping="Wrap" FontSize="12" />
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="#081F33" CornerRadius="10" Padding="12" Margin="12,0,0,0">
            <Grid RowDefinitions="Auto,Auto,Auto,*">
                <TextBlock Text="{Binding CurrentCard.Front}"
                           FontWeight="Bold"
                           FontSize="20"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Text="Deine Antwort" FontSize="12" Margin="0,10,0,0" />
                <ScrollViewer Grid.Row="2" Height="180" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <TextBox Text="{Binding UserAnswer}"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top" />
                </ScrollViewer>
                <StackPanel Grid.Row="3" Spacing="8" Margin="0,10,0,0">
                    <TextBlock Text="Block abgeschlossen. Bitte warten..." IsVisible="{Binding IsBatchComplete}" />
                    <TextBlock Text="{Binding BatchResultText}" TextWrapping="Wrap" IsVisible="{Binding IsBatchComplete}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
